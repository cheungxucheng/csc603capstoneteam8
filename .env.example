# ==============================================================================
# OwlChemy Configuration
# ==============================================================================

PORT=3000
DATABASE_PATH=./owlchemy.db

# ------------------------------------------------------------------------------
# LLM Provider Options (Choose Option A or Option B)
# ------------------------------------------------------------------------------

# Option A: Groq Cloud (Recommended: 100% Free, No Credit Card Required)
# 1. Sign up at https://console.groq.com
# 2. Create an API key at https://console.groq.com/keys
# 3. Paste below:
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Option B: Hugging Face Inference Providers Router
# 1. Create a token at https://huggingface.co/settings/tokens
# 2. Paste below:
HUGGINGFACE_API_TOKEN=

# Model identifier for Hugging Face Router:
# Note: 'meta-llama/Llama-3.1-8B-Instruct' is the standard provider-backed model on HF.
# (Note: Hugging Face router requires pre-paid credits added at https://huggingface.co/settings/billing).
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct
